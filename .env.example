# Backend API base URL (inlined into the browser bundle at build time).
# "/v1" = same-origin: next.config.ts proxies it to API_INTERNAL_URL, so no CORS
# is involved and the site works on any hostname (localhost, LAN, tunnel).
# An absolute URL (e.g. https://api.poojasevak.in/v1) calls the API directly.
NEXT_PUBLIC_API_URL=/v1

# Public URL of this site — used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:6002

# API URL reachable from the Next.js server itself (e.g. a Docker service
# name). Used by the /v1 proxy and server-side fetches such as the sitemap.
API_INTERNAL_URL=http://localhost:6001/v1
